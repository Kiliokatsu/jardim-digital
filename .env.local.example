# Copie para .env.local e preencha. Sem estas duas, o site roda em modo
# demonstração: todas as páginas de pé com dados de exemplo, sem banco.
#
# Supabase → Project Settings → API. A anon key é PÚBLICA por desenho —
# quem protege o dado é a RLS (supabase/migrations/), não o segredo da chave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
