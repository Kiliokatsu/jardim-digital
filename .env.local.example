# Copie para .env.local e preencha. Sem estas duas primeiras, o site roda em
# modo demonstração: o jardim mostra dados de exemplo e o painel abre sem login
# (só em desenvolvimento — em produção ele se recusa a abrir sem banco).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Quem entra no painel. Precisa ser igual ao e-mail cadastrado na tabela `donos`.
# Preencha no .env.local com o e-mail real — exemplo não carrega dado pessoal.
EMAIL_DONO=

# ─────────────────────────────────────────────────────────────────────────────
# Segredos das automações.
#
# O banco guarda apenas o NOME da variável (coluna integracoes.ref_segredo);
# o valor mora aqui e no host. É por isso que um dump do banco não vaza token.
# Adicione uma linha por automação, com o nome exato que está no painel.
# ─────────────────────────────────────────────────────────────────────────────

BREVO_API_KEY=
N8N_TOKEN_REDATOR=
